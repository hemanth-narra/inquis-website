# ==============================================================================
# Tailscale Configuration
# ==============================================================================

# Required: Generate an auth key from Tailscale admin console:
# https://login.tailscale.com/admin/settings/keys
# Recommended: Mark key as "Reusable" or "Ephemeral" (or use an OAuth client secret: tskey-client-...)
TS_AUTHKEY=tskey-auth-your-key-here

# Hostname that will appear on your Tailnet (e.g. http://inquis-website)
TS_HOSTNAME=inquis-website

# Optional: Extra arguments to pass to 'tailscale up'
# Examples:
#   TS_EXTRA_ARGS=--ssh                          (enable Tailscale SSH)
#   TS_EXTRA_ARGS=--advertise-tags=tag:server    (tag the node)
#   TS_EXTRA_ARGS=--reset                        (reset previous state)
TS_EXTRA_ARGS=

# Userspace networking mode:
# Set to 'false' if running on Linux with /dev/net/tun access (recommended).
# Set to 'true' if running on Windows/macOS or environments where /dev/net/tun is unavailable.
TS_USERSPACE=false

# ==============================================================================
# Local Host Port Mapping
# ==============================================================================
# Port on the Docker host machine to access the website locally (http://localhost:8080)
LOCAL_PORT=8080
