# ==============================================================================
# All-in-One Container: Nginx + Tailscale
# Use this when running on platforms that only support a single container
# (e.g., AWS ECS single task, Fly.io, Cloud Run, single Docker container)
# ==============================================================================

# Extract official tailscale binaries from tailscale image
FROM tailscale/tailscale:latest AS tailscale-bin

# Main Alpine + Nginx image
FROM nginx:alpine

# Install iptables & ca-certificates required for Tailscale
RUN apk add --no-cache ca-certificates iptables ip6tables curl

# Copy Tailscale binaries
COPY --from=tailscale-bin /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --from=tailscale-bin /usr/local/bin/tailscaled /usr/local/bin/tailscaled

# Copy custom Nginx configuration
RUN rm -rf /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy static website assets
COPY index.html /usr/share/nginx/html/
COPY script.js /usr/share/nginx/html/
COPY style.css /usr/share/nginx/html/
COPY robots.txt /usr/share/nginx/html/
COPY sitemap.xml /usr/share/nginx/html/
COPY img/ /usr/share/nginx/html/img/

# Copy and set permissions for entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose HTTP port
EXPOSE 80

# Environment variables with sensible defaults
ENV TS_HOSTNAME=inquis-website \
    TS_USERSPACE=true

ENTRYPOINT ["/entrypoint.sh"]
